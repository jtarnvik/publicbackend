# Template for deployment/publicbackend.env on the deploy machine.
#
# Copy to deployment/publicbackend.env there and fill in the real values. That file is gitignored
# and must never be committed — these are the same secrets Render holds as environment variables.
#
#   cp deployment/publicbackend.env.example deployment/publicbackend.env
#   chmod 600 deployment/publicbackend.env

# --- Database (local PostgreSQL on the Mac Mini) ---
export DB_URL=jdbc:postgresql://localhost:5432/commuter
export DB_USERNAME=publicbackend
export DB_PASSWORD=

# --- Google OAuth2 ---
export GOOGLE_CLIENT_ID=
export GOOGLE_CLIENT_SECRET=

# --- Frontend ---
# FRONTEND_URL is a SINGLE url and is where OAuth2 redirects after login.
export FRONTEND_URL=https://jtarnvik.github.io

# ALLOWED_ORIGINS is the CORS allowlist, comma-separated, no spaces needed. Optional — defaults to
# FRONTEND_URL alone. Set it to add a dev server pointed at this backend without breaking the
# redirect for everyone else. An origin is scheme + host + port and must match exactly: no trailing
# slash, no path, and http:// and https:// are different origins.
# export ALLOWED_ORIGINS=https://jtarnvik.github.io,http://localhost:5173

# --- Claude API ---
export ANTHROPIC_API_KEY=

# --- Pushover error notifications ---
export PUSHOVER_API_TOKEN=
export PUSHOVER_USER_KEY=

# --- Samtrafiken GTFS (static and realtime have SEPARATE keys) ---
export SAMTRAFIKEN_STATIC_API_KEY=
export SAMTRAFIKEN_REALTIME_API_KEY=

# --- JVM tuning (optional) ---
# Heap for the in-memory GTFS dataset plus the nightly parse peak. The Render 512MB cap is gone;
# raise this rather than keeping the dataset disabled.
# export JAVA_OPTS="-Xmx2g"
