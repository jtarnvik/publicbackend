# Template for deployment/publicbackend.env on the deploy machine.
#
# Copy to deployment/publicbackend.env there and fill in the real values. That file is gitignored
# and must never be committed — these are the same secrets Render holds as environment variables.
#
#   cp deployment/publicbackend.env.example deployment/publicbackend.env
#   chmod 600 deployment/publicbackend.env

# --- Database (MySQL in the `mysql-mini` Docker container on the Mac Mini) ---
# Deployment uses MySQL, the same engine as the `local` profile — not the PostgreSQL that Supabase
# provided. The `dbms="postgresql"` changesets (row level security, 002's BYTEA fix) therefore no
# longer apply in production; they stay in the changelog for history, and MySQL takes the LONGBLOB
# path from changeset 001 instead.
#
# The host is the LAN address rather than localhost because the container publishes on it.
export DB_URL=jdbc:mysql://192.168.1.204:3306/commuter_prod
export DB_USERNAME=jesper
export DB_PASSWORD=

# --- Google OAuth2 ---
export GOOGLE_CLIENT_ID=
export GOOGLE_CLIENT_SECRET=

# --- Frontend ---
# Both values below must name the DEPLOYED frontend origin. Getting either wrong broke the
# migration twice, in two different ways, so they are worth re-reading before a deploy:
#
#   FRONTEND_URL wrong  -> login appears to succeed, then dumps the user on the wrong host.
#   ALLOWED_ORIGINS wrong -> every API call gets a bare `403 Invalid CORS request` from Spring's
#     CorsFilter, which runs BEFORE the security chain: nothing reaches a controller, nothing is
#     usefully logged, and the backend looks dead rather than misconfigured.
#
# The CORS failure hides from local testing, which is how it survived a "passing" end-to-end test:
# a dev server on localhost:5173 is on the allowlist below, so testing from `npm run dev` proves
# nothing about the deployed origin. Verify the real one from outside instead:
#
#   curl -s -o /dev/null -w '%{http_code}\n' -X OPTIONS https://api2.tarnvik.com/api/auth/me \
#     -H 'Origin: https://sl.tarnvik.com' -H 'Access-Control-Request-Method: GET'
#
# 200 means allowed, 403 means not. Both values are read once at bean construction — a change here
# needs a restart, not just a file save.

# FRONTEND_URL is a SINGLE url and is where OAuth2 redirects after login.
export FRONTEND_URL=https://sl.tarnvik.com

# ALLOWED_ORIGINS is the CORS allowlist, comma-separated, no spaces needed. Optional — defaults to
# FRONTEND_URL alone. Set it to add a dev server pointed at this backend without breaking the
# redirect for everyone else. An origin is scheme + host + port and must match exactly: no trailing
# slash, no path, and http:// and https:// are different origins.
export ALLOWED_ORIGINS=https://sl.tarnvik.com,http://localhost:5173

# --- Claude API ---
export ANTHROPIC_API_KEY=

# --- Pushover error notifications ---
export PUSHOVER_API_TOKEN=
export PUSHOVER_USER_KEY=

# --- Samtrafiken GTFS (static and realtime have SEPARATE keys) ---
export SAMTRAFIKEN_STATIC_API_KEY=
export SAMTRAFIKEN_REALTIME_API_KEY=

# --- JVM tuning (optional) ---
# Heap for the in-memory GTFS dataset plus the nightly parse peak. The Render 512MB cap is gone;
# raise this rather than keeping the dataset disabled.
# export JAVA_OPTS="-Xmx2g"
